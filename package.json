{
  "name": "solar-system-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "fetch:textures": "node scripts/fetch-textures.mjs",
    "narration": ".venv\\Scripts\\python scripts\\generate-narration.py",
    "check:budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "camera-controls": "3.1.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
